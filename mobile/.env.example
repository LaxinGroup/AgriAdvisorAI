# Deployed API URL (ending in /api). APK builds always use this.
EXPO_PUBLIC_API_URL=https://your-api.example.com/api

# Development only (npx expo start): "local" uses the server on your computer (port 3000),
# "render" uses EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_TARGET=local

# Optional fixed local API URL, e.g. http://192.168.1.20:3000/api.
# Leave empty to detect your computer's address from the Expo dev server.
EXPO_PUBLIC_LOCAL_API_URL=

# Public Neon Auth URL for the configured Neon branch. Never put secrets here.
EXPO_PUBLIC_NEON_AUTH_URL=neon_auth_url
