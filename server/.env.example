PORT=3000
CORS_ORIGINS=http://localhost:8081
DATABASE_URL=
NEON_AUTH_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SOURCES_BUCKET=
# Google Gemini (written answers). Leave the key empty to return source excerpts only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Meaning-based search. Changing the model requires re-running `pnpm backfill:embeddings`
# for all passages (clear the embedding column first).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
